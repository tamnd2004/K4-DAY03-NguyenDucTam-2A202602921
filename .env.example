# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# LLM_PROVIDER: gemini hoặc openai. Demo offline: --offline ở CLI hoặc chọn trong UI.
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL='gemini-3.5-flash-lite'

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Database demo tùy chọn; đường dẫn mặc định data/peopleops.db
# HR_DB_PATH=D:/path/to/another-demo.db
# MCP dùng stdio; UI mặc định 127.0.0.1:8000 (đổi bằng src/web.py --port 8001).
